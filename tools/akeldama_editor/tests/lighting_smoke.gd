extends SceneTree
const Document = preload("res://levels/map_document.gd")
const Layer = preload("res://features/world/map_layer.gd")
const Placement = preload("res://features/world/objects/object_placement.gd")
const Lighting = preload("res://features/world/lighting/world_lighting.gd")

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var doc := Document.new()
	doc.create(10, 10)
	assert(not doc.terrain.lighting.shadows_enabled)
	doc.checkpoint()
	doc.terrain.lighting.shadows_enabled = true
	doc.terrain.lighting.ambient = Color(0.6, 0.7, 0.9)
	doc.undo()
	assert(not doc.terrain.lighting.shadows_enabled)
	doc.redo()
	assert(doc.terrain.lighting.shadows_enabled)
	var layer := Layer.new()
	layer.kind = Layer.Kind.OBJECTS
	var placed := Placement.new()
	placed.definition = load("res://features/world/objects/definitions/signpost.tres")
	placed.cell = Vector2i(4, 4)
	layer.objects.append(placed)
	doc.terrain.layers.append(layer)
	assert(doc.save("user://lighting_test.tres") == OK)
	var restored := Document.new()
	assert(restored.open("user://lighting_test.tres") == OK)
	assert(restored.terrain.lighting.shadows_enabled)
	assert(restored.terrain.lighting.ambient.is_equal_approx(Color(0.6, 0.7, 0.9)))
	var world := Node2D.new()
	root.add_child(world)
	var renderer := Lighting.new()
	world.add_child(renderer)
	var visual := AnimatedSprite2D.new()
	visual.sprite_frames = SpriteFrames.new()
	visual.sprite_frames.add_frame(&"default", placed.definition.texture)
	world.add_child(visual)
	renderer.setup(world, restored.terrain, visual)
	assert(renderer.get_child_count() == 2, "Expected prop and animated player shadows")
	await process_frame
	assert(world.modulate.is_equal_approx(restored.terrain.lighting.ambient))
	var shadow = renderer.get_child(0)
	assert(shadow.position == placed.world_origin() + placed.definition.depth_anchor)
	assert(shadow.z_index == -1)
	var projection: Transform2D = restored.terrain.lighting.projection(Vector2.ZERO)
	assert((projection * Vector2(0, -40)).x > 0, "Shadow must extend along configured direction")
	DirAccess.remove_absolute("user://lighting_test.tres")
	print("PASS: lighting defaults, undo/redo, save/load, tint, prop/player shadows and projection")
	quit()
