[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://features/story/story_catalog.gd" id="Catalog"]
[ext_resource type="Script" path="res://features/dialogue/dialogue_choice.gd" id="Choice"]
[ext_resource type="Script" path="res://features/dialogue/conversation_definition.gd" id="Conversation"]
[ext_resource type="Script" path="res://features/dialogue/dialogue_node.gd" id="Node"]
[ext_resource type="Script" path="res://features/quests/quest_definition.gd" id="Quest"]

[sub_resource type="Resource" id="Resource_s5xa1"]
script = ExtResource("Choice")
text = "I will read it."
next_node = "accepted"
action = "start"
action_quest = "read_notice"

[sub_resource type="Resource" id="Resource_aa2rk"]
script = ExtResource("Choice")
text = "Where is the sign?"
next_node = "directions"

[sub_resource type="Resource" id="Resource_8v38k"]
script = ExtResource("Choice")
text = "Maybe later."

[sub_resource type="Resource" id="Resource_s8lb6"]
script = ExtResource("Choice")
text = "Let's have a test battle."
action = "battle"

[sub_resource type="Resource" id="Resource_0t4ua"]
script = ExtResource("Choice")
text = "Please restore my Dama."
action = "heal_party"

[sub_resource type="Resource" id="Resource_w5qdb"]
script = ExtResource("Node")
id = "offer"
speaker = "Professor"
text = "Would you read the village noticeboard and report back to me?"
entry = true
condition_quest = "read_notice"
condition_state = "available"
choices = Array[ExtResource("Choice")]([SubResource("Resource_s5xa1"), SubResource("Resource_aa2rk"), SubResource("Resource_8v38k"), SubResource("Resource_s8lb6"), SubResource("Resource_0t4ua")])

[sub_resource type="Resource" id="Resource_i8rsd"]
script = ExtResource("Choice")
text = "All right."
next_node = "offer"

[sub_resource type="Resource" id="Resource_4qtu6"]
script = ExtResource("Node")
id = "directions"
speaker = "Professor"
text = "The wooden sign is just east of me. Read it, then come back."
choices = Array[ExtResource("Choice")]([SubResource("Resource_i8rsd")])

[sub_resource type="Resource" id="Resource_t1l0u"]
script = ExtResource("Choice")
text = "Goodbye."

[sub_resource type="Resource" id="Resource_i0dbl"]
script = ExtResource("Choice")
text = "Any other work I can do at the same time?"
next_node = "side_accepted"
action = "start"
action_quest = "record_warning"

[sub_resource type="Resource" id="Resource_x3gkd"]
script = ExtResource("Node")
id = "accepted"
speaker = "Professor"
text = "Thank you. The notice may explain what happened here."
choices = Array[ExtResource("Choice")]([SubResource("Resource_t1l0u"), SubResource("Resource_i0dbl")])

[sub_resource type="Resource" id="Resource_xt51p"]
script = ExtResource("Choice")
text = "Goodbye."

[sub_resource type="Resource" id="Resource_ovguf"]
script = ExtResource("Choice")
text = "I also recorded the evacuation warning."
next_node = "side_thanks"
condition_quest = "record_warning"
condition_state = "ready"
action = "complete"
action_quest = "record_warning"

