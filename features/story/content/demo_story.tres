[sub_resource type="Resource" id="Resource_0srva"]
script = ExtResource("Choice")
text = "Goodbye."

[sub_resource type="Resource" id="Resource_ultxt"]
script = ExtResource("Node")
id = "thanks"
speaker = "Professor"
text = "Evacuation routes... that confirms my fears. Thank you for your help."
choices = Array[ExtResource("Choice")]([SubResource("Resource_0srva")])

