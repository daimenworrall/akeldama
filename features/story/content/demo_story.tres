[sub_resource type="Resource" id="Resource_t7sd0"]
script = ExtResource("Node")
id = "done"
speaker = "Professor"
text = "Your report was useful. Stay safe out there."
entry = true
condition_quest = "read_notice"
condition_state = "completed"
choices = Array[ExtResource("Choice")]([SubResource("Resource_sms2h"), SubResource("Resource_74cib"), SubResource("Resource_1oibu"), SubResource("Resource_kknuk"), SubResource("Resource_itcki"), SubResource("Resource_dd1v0"), SubResource("Resource_hqx10")])

[sub_resource type="Resource" id="Resource_qrabc"]
script = ExtResource("Choice")
text = "Goodbye."

[sub_resource type="Resource" id="Resource_afbf2"]
script = ExtResource("Node")
id = "side_accepted"
speaker = "Professor"
text = "Please record the evacuation warning while you are there. You can work on both requests together."
choices = Array[ExtResource("Choice")]([SubResource("Resource_qrabc")])

[sub_resource type="Resource" id="Resource_tumri"]
script = ExtResource("Choice")
text = "Goodbye."

[sub_resource type="Resource" id="Resource_cb6qd"]
script = ExtResource("Node")
id = "side_thanks"
speaker = "Professor"
text = "Thank you. I have your record of the evacuation warning."
choices = Array[ExtResource("Choice")]([SubResource("Resource_tumri")])

[sub_resource type="Resource" id="Resource_6gwkl"]
script = ExtResource("Choice")
text = "Goodbye."

[sub_resource type="Resource" id="Resource_5jvcb"]
script = ExtResource("Node")
id = "followup_accepted"
speaker = "Professor"
text = "Now that I have your first report, please revisit the noticeboard and confirm the route instructions."
choices = Array[ExtResource("Choice")]([SubResource("Resource_6gwkl")])

[sub_resource type="Resource" id="Resource_aq1y5"]
script = ExtResource("Choice")
text = "Goodbye."

[sub_resource type="Resource" id="Resource_cmk87"]
script = ExtResource("Node")
id = "followup_thanks"
speaker = "Professor"
text = "That confirms it. We can prepare the evacuation route."
choices = Array[ExtResource("Choice")]([SubResource("Resource_aq1y5")])

[sub_resource type="Resource" id="Resource_duhut"]
script = ExtResource("Conversation")
id = "professor_intro"
title = "Professor — village notice"
nodes = Array[ExtResource("Node")]([SubResource("Resource_w5qdb"), SubResource("Resource_4qtu6"), SubResource("Resource_x3gkd"), SubResource("Resource_lw132"), SubResource("Resource_vlcmr"), SubResource("Resource_ultxt"), SubResource("Resource_t7sd0"), SubResource("Resource_afbf2"), SubResource("Resource_cb6qd"), SubResource("Resource_5jvcb"), SubResource("Resource_cmk87")])

[sub_resource type="Resource" id="Resource_tvfkw"]
script = ExtResource("Choice")
text = "Goodbye."

[sub_resource type="Resource" id="Resource_yncf4"]
script = ExtResource("Node")
id = "notice"
speaker = "Village noticeboard"
text = "VILLAGE NOTICE: Keep the eastern crossing clear. Follow marked evacuation routes. Report unusual creatures to the professor."
entry = true
choices = Array[ExtResource("Choice")]([SubResource("Resource_tvfkw")])

[sub_resource type="Resource" id="Resource_i1jlo"]
script = ExtResource("Conversation")
id = "village_notice"
title = "Village noticeboard"
nodes = Array[ExtResource("Node")]([SubResource("Resource_yncf4")])

[sub_resource type="Resource" id="Resource_gssjp"]
script = ExtResource("Quest")
id = "read_notice"
title = "Read the village notice"
description = "Read the signpost east of the professor, then report back."
targets = PackedStringArray("demo-village-noticeboard")
prerequisites = PackedStringArray()
objective_texts = PackedStringArray("Read the village noticeboard.")

[sub_resource type="Resource" id="Resource_4mxcv"]
script = ExtResource("Quest")
id = "record_warning"
title = "Record the evacuation warning"
description = "Make a separate record of the noticeboard's evacuation warning for the professor."
targets = PackedStringArray("demo-village-noticeboard")
prerequisites = PackedStringArray()
objective_texts = PackedStringArray("Record the warning on the village noticeboard.")

[sub_resource type="Resource" id="Resource_8nl3x"]
script = ExtResource("Quest")
id = "confirm_notice"
title = "Confirm the evacuation route"
description = "After reporting the first notice, return to the board and confirm the evacuation instructions."
targets = PackedStringArray("demo-village-noticeboard")
prerequisites = PackedStringArray("read_notice")
objective_texts = PackedStringArray("Revisit the noticeboard and confirm the instructions.")

[resource]
script = ExtResource("Catalog")
quests = Array[ExtResource("Quest")]([SubResource("Resource_gssjp"), SubResource("Resource_4mxcv"), SubResource("Resource_8nl3x")])
conversations = Array[ExtResource("Conversation")]([SubResource("Resource_duhut"), SubResource("Resource_i1jlo")])
