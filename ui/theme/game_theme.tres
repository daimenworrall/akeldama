[gd_resource type="Theme" load_steps=5 format=3]

[sub_resource type="StyleBoxFlat" id="panel"]
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0
bg_color = Color(0.055, 0.075, 0.12, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.55, 0.65, 1)

[sub_resource type="StyleBoxFlat" id="button"]
content_margin_left = 10.0
content_margin_top = 5.0
content_margin_right = 10.0
content_margin_bottom = 5.0
bg_color = Color(0.12, 0.19, 0.26, 1)

[sub_resource type="StyleBoxFlat" id="hover"]
content_margin_left = 10.0
content_margin_top = 5.0
content_margin_right = 10.0
content_margin_bottom = 5.0
bg_color = Color(0.22, 0.35, 0.42, 1)

[sub_resource type="StyleBoxFlat" id="focus"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.6, 0.88, 0.8, 1)

[resource]
default_font_size = 14
PanelContainer/styles/panel = SubResource("panel")
Button/styles/normal = SubResource("button")
Button/styles/hover = SubResource("hover")
Button/styles/pressed = SubResource("hover")
Button/styles/focus = SubResource("focus")
OptionButton/styles/normal = SubResource("button")
OptionButton/styles/hover = SubResource("hover")
OptionButton/styles/pressed = SubResource("hover")
OptionButton/styles/focus = SubResource("focus")
VBoxContainer/constants/separation = 8
HBoxContainer/constants/separation = 12
TabContainer/styles/panel = SubResource("panel")
TabContainer/styles/tab_selected = SubResource("hover")
TabContainer/styles/tab_unselected = SubResource("button")
