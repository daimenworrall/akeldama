extends SceneTree
const Catalog = preload("res://features/story/content/demo_story.tres")
const Journal = preload("res://features/quests/quest_journal.gd")
const Dependencies = preload("res://features/quests/quest_dependencies.gd")
const Session = preload("res://features/dialogue/conversation_session.gd")
const Save = preload("res://features/quests/quest_save.gd")

func _initialize() -> void:
	var journal := Journal.new()
	journal.catalog = Catalog
	assert(journal.state("confirm_notice") == "locked")
	assert(not journal.start("confirm_notice"), "Direct start bypassed prerequisite")
	assert(journal.start("read_notice") and journal.start("record_warning"))
	journal.track("record_warning")
	assert(journal.progress.size() == 2 and journal.tracked_id == "record_warning")
	journal.interact("demo-village-noticeboard")
	assert(journal.state("read_notice") == "ready" and journal.state("record_warning") == "ready")
	assert(not journal.start("confirm_notice"), "Ready is not completed")
	assert(journal.complete("read_notice"))
	assert(journal.state("confirm_notice") == "available")
	assert(journal.start("confirm_notice"))
	assert(journal.state("record_warning") == "ready" and journal.state("confirm_notice") == "active")
	assert(Save.write(journal, "user://quest_journal_test.json") == OK)
	var restored := Journal.new()
	restored.catalog = Catalog
	Save.load_into(restored, "user://quest_journal_test.json")
	assert(restored.tracked_id == "record_warning")
	assert(restored.state("read_notice") == "completed" and restored.state("confirm_notice") == "active")
	assert(restored.complete("record_warning"))
	assert(restored.tracked_id == "confirm_notice", "Tracking did not move to another active quest")
	var legacy := journal.snapshot()
	legacy.erase("tracked")
	restored.restore(legacy)
	assert(not restored.tracked_id.is_empty())
	var broken = Catalog.duplicate(true)
	broken.quest("read_notice").prerequisites = PackedStringArray(["confirm_notice"])
	assert(not Dependencies.errors(broken).is_empty(), "Dependency cycle accepted")
	broken.quest("read_notice").prerequisites = PackedStringArray(["missing"])
	assert(not Dependencies.errors(broken).is_empty())
	broken.quest("read_notice").prerequisites = PackedStringArray(["read_notice"])
	assert(not Dependencies.errors(broken).is_empty())
	var all_required = Catalog.duplicate(true)
	all_required.quest("confirm_notice").prerequisites.append("record_warning")
	var gated := Journal.new()
	gated.catalog = all_required
	assert(gated.start("read_notice"))
	gated.interact("demo-village-noticeboard")
	assert(gated.complete("read_notice"))
	assert(not gated.start("confirm_notice"), "All prerequisites must be completed")
	var session := Session.new()
	session.journal = gated
	assert(session.begin(all_required.conversation("professor_intro")))
	for choice in session.choices():
		assert(choice.action_quest != "confirm_notice" or choice.action != "start")
	DirAccess.remove_absolute("user://quest_journal_test.json")
	print("PASS: enforced/all prerequisites, concurrent progress, tracking, save/legacy restore, dependency validation and dialogue gating")
	quit()
