extends SceneTree
const Catalog = preload("res://features/story/content/demo_story.tres")
const Journal = preload("res://features/quests/quest_journal.gd")
const Quest = preload("res://features/quests/quest_definition.gd")
const Save = preload("res://features/quests/quest_save.gd")

func _initialize() -> void:
	var catalog = Catalog.duplicate(true)
	var leaf := Quest.new()
	leaf.id = "third_step"
	leaf.prerequisites = PackedStringArray(["confirm_notice", "record_warning"])
	leaf.targets = PackedStringArray(["demo-village-noticeboard"])
	catalog.quests.append(leaf)
	var journal := Journal.new()
	journal.catalog = catalog
	assert(journal.start("read_notice") and journal.start("record_warning"))
	journal.interact("demo-village-noticeboard")
	assert(journal.complete("read_notice") and journal.complete("record_warning"))
	assert(journal.start("confirm_notice"))
	journal.interact("demo-village-noticeboard")
	assert(journal.complete("confirm_notice") and journal.start("third_step"))
	journal.track("third_step")
	var before: Dictionary = journal.snapshot()
	var notifications := [0]
	journal.changed.connect(func() -> void: notifications[0] += 1)
	var affected: PackedStringArray = journal.reset("read_notice")
	assert(affected.size() == 3 and "third_step" in affected)
	assert(journal.state("read_notice") == "available")
	assert(journal.state("confirm_notice") == "locked" and journal.state("third_step") == "locked")
	assert(journal.state("record_warning") == "completed", "Unrelated prerequisite was reset")
	assert(journal.tracked_id.is_empty() and notifications[0] == 1)
	assert(Save.write(journal, "user://quest_reset_test.json") == OK)
	var restored := Journal.new()
	restored.catalog = catalog
	Save.load_into(restored, "user://quest_reset_test.json")
	assert(restored.state("third_step") == "locked" and restored.state("read_notice") == "available")
	assert(journal.reset("missing").is_empty())
	journal.reset("read_notice")
	assert(notifications[0] == 1, "No-op reset should not notify or save")
	journal.restore(before)
	journal.reset("confirm_notice")
	assert(journal.state("read_notice") == "completed", "Reset must not clear ancestors")
	assert(journal.state("confirm_notice") == "available" and journal.state("third_step") == "locked")
	journal.restore(before)
	# Preserve tracking on an unaffected active quest, or choose it if tracking is reset.
	journal.completed.erase("record_warning")
	journal.track("record_warning")
	journal.reset("confirm_notice")
	assert(journal.tracked_id == "record_warning")
	journal.restore(before)
	journal.completed.erase("record_warning")
	journal.reset("read_notice")
	assert(journal.tracked_id == "record_warning")
	DirAccess.remove_absolute("user://quest_reset_test.json")
	print("PASS: transitive/branched reset, preserved ancestors/unrelated quests, tracking repair, one notification, no-op handling and persistence")
	quit()
